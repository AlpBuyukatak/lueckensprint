    "languageNaturalnessScore":{"type":"number","minimum":0,"maximum":100},"coherenceScore":{"type":"number","minimum":0,"maximum":100},"cefrConfidence":{"type":"number","minimum":0,"maximum":1},"ctestValidityScore":{"type":"number","minimum":0,"maximum":100},"overallConfidence":{"type":"number","minimum":0,"maximum":1},"finalDecision":{"enum":["PASS","FIX","QUARANTINE","REJECT"]},
    "problems":{"type":"array"},"proposedCorrections":{"type":"array"},"reviewedGapResults":{"type":"array"},"reviewerAgreement":{"type":"string"},"quarantineReasons":{"type":"array"},"reviewModel":{"type":"string"},"promptVersion":{"type":"string"},"reviewedAt":{"type":"string"}
  }
