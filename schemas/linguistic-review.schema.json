{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LueckenSprint linguistic review v1",
  "type": "object",
  "required": ["textId","originalLevel","proposedLevel","languageNaturalnessScore","coherenceScore","cefrConfidence","ctestValidityScore","overallConfidence","finalDecision","problems","proposedCorrections","reviewedGapResults","reviewerAgreement","quarantineReasons","reviewModel","promptVersion","reviewedAt"],
